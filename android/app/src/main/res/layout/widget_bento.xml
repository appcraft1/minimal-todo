<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_bento"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: App Title & Streak Badge (RelativeLayout: 100% RemoteViews Compatible) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="Minimal Todo"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_widget_streak"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="0 Hari Streak"
            android:textColor="#FC5200"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Progress Rate Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_widget_bar" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:text="0/0 Selesai (0%)"
            android:textColor="#FDE047"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dynamic Bento Habit Cards Container (Populated with actual cards from Home) -->
    <LinearLayout
        android:id="@+id/widget_habits_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_item"
        android:gravity="center"
        android:padding="10dp"
        android:text="Belum ada target hari ini. Ketuk untuk buat kartu baru!"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- More habits footer indicator -->
    <TextView
        android:id="@+id/widget_footer_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="+ 0 target lainnya • Buka Beranda"
        android:textColor="#FDE047"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
